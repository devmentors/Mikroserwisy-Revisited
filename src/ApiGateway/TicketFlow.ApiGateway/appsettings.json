{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "AppName": "api-gateway"
  },
  "metrics": {
    "prometheus": {
      "enabled": true
    },
    "system": {
      "enabled": false
    }
  },
  "ReverseProxy": {
    "Routes": {
      "tickets-list": {
        "ClusterId": "tickets",
        "Match": {
          "Path": "/tickets",
          "Methods": [ "GET" ]
        }
      },
      "tickets-instance": {
        "ClusterId": "tickets",
        "Match": {
          "Path": "/tickets/instance",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathSet": "/instance" },
          { "RequestHeader": "Connection", "Set": "close" }
        ]
      },
      "tickets-assign": {
        "ClusterId": "tickets",
        "Match": {
          "Path": "/tickets/{ticketId}/assign/{agentId}",
          "Methods": [ "POST" ]
        }
      },
      "tickets-block": {
        "ClusterId": "tickets",
        "Match": {
          "Path": "/tickets/{ticketId}/block/{reason}",
          "Methods": [ "POST" ]
        }
      },
      "tickets-unblock": {
        "ClusterId": "tickets",
        "Match": {
          "Path": "/tickets/{ticketId}/unblock/{reason}",
          "Methods": [ "POST" ]
        }
      },
      "tickets-resolve": {
        "ClusterId": "tickets",
        "Match": {
          "Path": "/tickets/{ticketId}/resolve/{resolution}",
          "Methods": [ "POST" ]
        }
      },
      "tickets-qualify": {
        "ClusterId": "tickets",
        "Match": {
          "Path": "/tickets/{ticketId}/qualify",
          "Methods": [ "POST" ]
        }
      },
      "tickets-client-notes": {
        "ClusterId": "tickets",
        "Match": {
          "Path": "/tickets/{ticketId}/client-notes",
          "Methods": [ "GET", "POST" ]
        }
      },
      "agents-list": {
        "ClusterId": "tickets",
        "Match": {
          "Path": "/agents",
          "Methods": [ "GET" ]
        }
      },
      "agents-get": {
        "ClusterId": "tickets",
        "Match": {
          "Path": "/agents/{agentId}",
          "Methods": [ "GET" ]
        }
      },
      "messages-logged-users": {
        "ClusterId": "communication",
        "Match": {
          "Path": "/logged-users/{userId}/messages",
          "Methods": [ "GET" ]
        }
      },
      "messages-anonymous-users": {
        "ClusterId": "communication",
        "Match": {
          "Path": "/anonymous-users/messages",
          "Methods": [ "GET" ]
        }
      },
      "messages-update": {
        "ClusterId": "communication",
        "Match": {
          "Path": "/messages/{messageId}",
          "Methods": [ "PUT" ]
        }
      },
      "alerts-list": {
        "ClusterId": "communication",
        "Match": {
          "Path": "/alerts",
          "Methods": [ "GET" ]
        }
      },
      "alerts-update": {
        "ClusterId": "communication",
        "Match": {
          "Path": "/alerts/{alertId}",
          "Methods": [ "PUT" ]
        }
      },
      "live-metrics": {
        "ClusterId": "system-metrics",
        "Match": {
          "Path": "/live-metrics/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "tickets": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5400"
          }
        }
      },
      "communication": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5600"
          }
        }
      },
      "system-metrics": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5900"
          }
        }
      }
    }
  }
}
