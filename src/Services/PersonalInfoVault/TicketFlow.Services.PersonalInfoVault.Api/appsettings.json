{
  "App": {
    "AppName": "vault-service"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "metrics": {
    "prometheus": {
      "enabled": true
    },
    "system": {
      "enabled": false
    }
  },
  "Postgres": {
    "ConnectionString": "Host=localhost;Database=TicketFlow.PersonalInfoVault;Username=postgres;Password="
  },
  "rabbitMq": {
    "hostName": "localhost",
    "port": 5672,
    "username": "guest",
    "password": "guest",
    "virtualHost": "/",
    "createTopology": true
  },
  "Resiliency": {
    "Consumer": {
      "BrokerRetriesEnabled": false,
      "BrokerRetriesLimit": 3,
      "ConsumerRetriesEnabled": false,
      "UseDeadletter": false,
      "PublishFaultOnFailure": false,
      "MaxMessagesFetchedPerConsumer": 10
    },
    "Producer": {
      "PublisherConfirmsEnabled": false,
      "PublishMandatoryEnabled": false
    }
  }
}
