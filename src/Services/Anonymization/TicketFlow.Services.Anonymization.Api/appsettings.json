{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "AppName": "anonymization-service"
  },
  "metrics": {
    "prometheus": {
      "enabled": true
    }
  },
  "Postgres": {
    "ConnectionString": "Host=localhost;Database=TicketFlow.Anonymization;Username=postgres;Password=postgres"
  },
  "rabbitMq": {
    "hostName": "localhost",
    "port": 5672,
    "username": "guest",
    "password": "guest",
    "virtualHost": "/",
    "createTopology": true
  },
  "Resiliency": {
    "Consumer": {
      "BrokerRetriesEnabled": false,
      "BrokerRetriesLimit": 3,
      "ConsumerRetriesEnabled": false,
      "UseDeadletter": false,
      "PublishFaultOnFailure": false,
      "MaxMessagesFetchedPerConsumer": 10
    },
    "Producer": {
      "PublisherConfirmsEnabled": false,
      "PublishMandatoryEnabled": false
    }
  },
  "Services": {
    "PersonalInfoVault": "http://localhost:6100"
  }
}
